---
import CopyCommand from "../components/CopyCommand.astro";
import Kinds from "../components/Kinds.astro";
import Palette from "../components/Palette.astro";
import SubmitCta from "../components/SubmitCta.astro";
import Layout from "../layouts/Layout.astro";
import { getEntries } from "../lib/registry";
import { CLI } from "../lib/site";

const entries = await getEntries();
---

<Layout>
  <div class="container">
    <section class="hero">
      <p class="eyebrow">
        <b>●</b> open-source directory · {entries.length} entries
      </p>
      <h1>
        Sub-agents and skills for Claude&nbsp;Code.{" "}
        <span class="muted">Read the file, then install it.</span>
      </h1>
      <p class="hero-lede">
        Useful, well-written prompts you can check line by line before you use them. Install one
        into your project with a single command.
      </p>
      <div class="hero-actions">
        <CopyCommand command={`${CLI} add code-reviewer`} highlight="code-reviewer" />
        <a class="button" href="#browse">
          Browse all
        </a>
      </div>
      <ul class="hero-meta">
        <li>Free and MIT licensed</li>
        <li>No account, no tracking</li>
        <li>Plain files, no lock-in</li>
      </ul>
    </section>

    <section id="browse" aria-label="Browse the directory">
      <Palette entries={entries} />
    </section>

    <Kinds />
    <SubmitCta />
  </div>
</Layout>
