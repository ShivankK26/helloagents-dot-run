---
import CopyCommand from "./CopyCommand.astro";
import Icon from "./Icon.astro";
import {
  entryPath,
  formatBytes,
  installCommand,
  rawPath,
  toolsList,
  typeLabel,
  type LoadedEntry,
} from "../lib/registry";

interface Props {
  entry: LoadedEntry;
}
const { entry } = Astro.props;
const tools = toolsList(entry);
const size = entry.files.reduce((n, f) => n + f.size, 0);
const main = entry.files[0];
---

<li class="row" data-name={entry.name} data-type={entry.type}>
  <details>
    <summary>
      <span class:list={["badge", `badge-${entry.type}`]}>
        {entry.type === "agent" ? "agent" : "skill"}
      </span>
      <span class="row-name">{entry.name}</span>
      <span class="row-desc">{entry.description}</span>
      <span class="row-cat">{entry.category}</span>
      <Icon name="chevron" class="chevron" />
    </summary>
    <div class="row-body">
      <div>
        <p>{entry.description}</p>
        {entry.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {entry.tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )}
        <dl class="meta">
          <dt>type</dt>
          <dd>{typeLabel(entry.type)}</dd>
          {tools && (
            <>
              <dt>{entry.type === "agent" ? "tools" : "allowed"}</dt>
              <dd>
                <code>{tools}</code>
              </dd>
            </>
          )}
          <dt>files</dt>
          <dd>
            {entry.files.length} · {formatBytes(size)}
          </dd>
          {entry.author && (
            <>
              <dt>author</dt>
              <dd>
                <a href={`https://github.com/${entry.author}`} rel="noopener">
                  @{entry.author}
                </a>
              </dd>
            </>
          )}
        </dl>
      </div>
      <div class="row-side">
        <CopyCommand command={installCommand(entry.name)} highlight={entry.name} />
        <div class="row-links">
          <a class="button button-primary" href={entryPath(entry)}>
            View file <Icon name="arrow" />
          </a>
          {main && (
            <a class="button" href={rawPath(main)}>
              Raw
            </a>
          )}
        </div>
      </div>
    </div>
  </details>
</li>
