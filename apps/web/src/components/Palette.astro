---
import EntryRow from "./EntryRow.astro";
import Icon from "./Icon.astro";
import { REQUEST_URL } from "../lib/site";
import type { LoadedEntry } from "../lib/registry";

interface Props {
  entries: LoadedEntry[];
}
const { entries } = Astro.props;
const agents = entries.filter((e) => e.type === "agent").length;
const skills = entries.length - agents;
---

<div class="palette" data-palette>
  <label class="palette-search">
    <Icon name="search" />
    <span class="visually-hidden">Search sub-agents and skills</span>
    <input
      type="search"
      data-palette-input
      placeholder={`Search ${entries.length} sub-agents and skills…`}
      autocomplete="off"
      spellcheck="false"
      aria-controls="palette-rows"
      aria-describedby="palette-status"
    />
    <kbd aria-hidden="true">/</kbd>
  </label>
  <div class="palette-bar">
    <div class="filters" role="group" aria-label="Filter by type">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">
        All <span class="count">{entries.length}</span>
      </button>
      <button type="button" class="filter" data-filter="agent" aria-pressed="false">
        Sub-agents <span class="count">{agents}</span>
      </button>
      <button type="button" class="filter" data-filter="skill" aria-pressed="false">
        Skills <span class="count">{skills}</span>
      </button>
    </div>
    <span class="palette-status" id="palette-status" data-palette-status aria-live="polite">
      {entries.length} entries
    </span>
  </div>
  <ul class="rows" id="palette-rows" data-palette-rows>
    {entries.map((entry) => (
      <EntryRow entry={entry} />
    ))}
  </ul>
  <div class="empty" data-palette-empty hidden>
    <p>
      Nothing matches <strong data-palette-query></strong>.
    </p>
    <p>
      <a href={REQUEST_URL} rel="noopener">
        Request it
      </a>{" "}
      or <a href="/submit/">submit your own</a>.
    </p>
  </div>
  <div class="palette-foot" aria-hidden="true">
    <span>
      <kbd>/</kbd> search
    </span>
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> move
    </span>
    <span>
      <kbd>↵</kbd> expand
    </span>
    <span class="hide-sm">
      <kbd>esc</kbd> clear
    </span>
  </div>
</div>

<script>
  import { initPalette } from "../scripts/palette";

  const el = document.querySelector<HTMLElement>("[data-palette]");
  if (el) initPalette(el);
</script>
