---
import Icon from "./Icon.astro";
import { REPO_URL } from "../lib/site";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo" aria-label="helloagents.run home">
      <span class="logo-mark" aria-hidden="true">
        h
      </span>
      <span>
        helloagents<span class="logo-tld">.run</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/#browse" class="nav-browse" aria-current={path === "/" ? "page" : undefined}>
        Browse
      </a>
      <a href="/submit/" aria-current={path.startsWith("/submit") ? "page" : undefined}>
        Submit
      </a>
      <a href={REPO_URL} rel="noopener">
        <Icon name="github" />
        <span class="nav-label">GitHub</span>
      </a>
      <button type="button" class="icon-button" data-theme-toggle aria-label="Switch color theme">
        <Icon name="sun" class="theme-icon-dark" />
        <Icon name="moon" class="theme-icon-light" />
      </button>
    </nav>
  </div>
</header>
