{
  "name": "helloagents-monorepo",
  "private": true,
  "description": "helloagents.run \u2014 a free, open-source directory of Claude Code skills and sub-agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter web build && pnpm --filter @helloagents/cli build",
    "dev": "pnpm --filter web dev",
    "registry:validate": "pnpm --filter @helloagents/schema build && node packages/schema/dist/cli.js validate",
    "registry:build": "pnpm --filter @helloagents/schema build && node packages/schema/dist/cli.js build --out .registry-out",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "design:reference": "pnpm --filter web build && node scripts/design-reference.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
